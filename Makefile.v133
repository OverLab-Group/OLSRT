# Makefile.v133 — build and run the v1.3.3/v1.3.4.1 regression suites.
#
# Usage (from project root):
#   make -C demos
#   make -f Makefile.v133 run

CC      ?= cc
CFLAGS  := -std=gnu11 -O1 -g -Wall -Wextra \
           -Wno-unused-parameter -D_GNU_SOURCE

INCLUDES := -Iincludes \
            -Iincludes/code \
            -Iincludes/code/streams \
            -Iincludes/code/network \
            -Iincludes/runtime

LDLIBS  := -Ldemos -lolsrt "-Wl,-rpath,$(CURDIR)/demos" \
           -lpthread -lrt -ldl -lnuma

BINS := test_v133_fixes test_oroutines

.PHONY: all run clean

all: $(BINS)

test_v133_fixes: tests/test_v133_fixes.c demos/libolsrt.so
	$(CC) $(CFLAGS) $(INCLUDES) $< $(LDLIBS) -o $@

test_oroutines: tests/test_oroutines.c demos/libolsrt.so
	$(CC) $(CFLAGS) $(INCLUDES) $< $(LDLIBS) -o $@

demos/libolsrt.so:
	@echo "error: demos/libolsrt.so not found." >&2
	@echo "       Run: make -C demos" >&2
	@exit 1

run: $(BINS)
	@echo "=== test_v133_fixes ==="
	./test_v133_fixes
	@echo
	@echo "=== test_oroutines ==="
	./test_oroutines

clean:
	rm -f $(BINS)
